# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=rag-chatbot

# ── Supabase (application tables) ────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=eyJ...   # service role key

# ── Supabase (direct PostgreSQL for LangGraph checkpointer) ───────────────────
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Supabase JWT ──────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret

# ── FastAPI server ────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

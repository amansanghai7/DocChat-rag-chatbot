# Git
.git/
.gitignore

# Secrets — never baked into the image
.env
.env.*

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
env/

# Test artefacts
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# Local DB
*.db
*.sqlite3

# Uploaded files (mounted at runtime instead)
uploads/*

# Docs only (not needed at runtime)
*.md
docs/
